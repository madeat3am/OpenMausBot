[Unit]
Description=OpenMausBot Poppy background receiver
After=network-online.target
Wants=network-online.target

# Source template only; installation and activation use the deployment owner.

[Service]
Type=simple
ExecStart=/usr/bin/node /ABSOLUTE/PATH/TO/OpenMausBot/desktop-receiver/run.mjs --config %h/.config/openmausbot/poppy-receiver.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/openmausbot

[Install]
WantedBy=default.target
